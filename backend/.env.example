# Copy to backend/.env and fill in your real SMTP details (required for email).

# Local MongoDB (install MongoDB Community) or MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/tube-mill-app

SMTP_HOST=smtp.gmail.com
# Render/production: prefer 465 + SSL (IPv4). Local: 465 or 587 both work.
SMTP_PORT=465
SMTP_SECURE=SSL
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Optional: prefill supervisor email for new users (each user can change it in the app)
DEFAULT_SUPERVISOR_EMAIL=supervisor@yourcompany.com

API_URL=http://localhost:3001
APP_URL=http://localhost:5173
# Links in supervisor emails (Approve / Reject). Local dev:
PUBLIC_APP_URL=http://localhost:5173
# On Render (production): set in Render dashboard to your Vercel URL, e.g. https://your-app.vercel.app

JWT_SECRET=change-me-in-production

# Comma-separated emails get role admin on register/login (also stored in MongoDB users.role)
ADMIN_EMAILS=your-admin@company.com

# Or set in MongoDB Atlas: users collection → role: "admin" | "user"

# If your provider only allows sending from SMTP_USER, set to true (Reply-To stays the logged-in user)
SMTP_FORCE_FROM_ACCOUNT=true
